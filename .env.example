# ========================================
# VoIP Automation - Environment Variables
# ========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Load before running:  source .env
# ========================================

# --- Linphone Script (linphone_call_test.sh) ---
DEST_PHONE="<YOUR_PHONE_NUMBER>"
VOIP_PROXY_HOST="<YOUR_VOIP_PROXY_HOST>"
VOIP_USERNAME="<YOUR_VOIP_USERNAME>"
VOIP_PASSWORD="<YOUR_VOIP_PASSWORD>"
# Optional: full SIP identity (auto-built if not set)
VOIP_IDENTITY="sip:<YOUR_VOIP_USERNAME>@<YOUR_VOIP_PROXY_HOST>"

# --- Zoiper Script (zoiper_call_test.sh) ---
ZOIPER_PHONE="<YOUR_ZOIPER_PHONE_NUMBER>"
ZOIPER_WAVE_FILE="./audiosamples/sample-speech-30m.wav"
